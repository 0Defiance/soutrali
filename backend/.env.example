APP_NAME=Soutrali
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:8082
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=soutrali
DB_USERNAME=soutrali_dev
DB_PASSWORD=

# SSL MySQL (AlwaysData et hébergeurs similaires : « Connexion SSL requise »).
# PDO ne chiffre pas par défaut, d’où « Access denied » alors que les
# identifiants sont justes — le client mysql chiffre, PDO non. Pointé sur le
# magasin système, PDO chiffre la connexion ET vérifie le certificat
# (config/database.php lit MYSQL_ATTR_SSL_CA). En local sans SSL : commenté.
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=127.0.0.1
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:8082,localhost:8082,127.0.0.1:8083,localhost:8083,127.0.0.1:8000,localhost:8000

# E-mails transactionnels (F-09).
# En local : MAIL_MAILER=log écrit les e-mails dans storage/logs/laravel.log
# (aucun compte requis). En réel : MAIL_MAILER=smtp + identifiants Mailjet
# (hôte in-v3.mailjet.com, port 587, clé API et clé secrète, jamais de mot
# de passe de compte). MAIL_SCHEME doit rester vide sur le port 587 : la
# montée en sécurité STARTTLS est automatique ; « tls » ferait lever
# UnsupportedSchemeException (« smtps » + port 465 est l’alternative).
# Voir docs/INSTALLATION.md § "E-mails".
MAIL_MAILER=log
MAIL_HOST=in-v3.mailjet.com
MAIL_PORT=587
MAIL_SCHEME=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@soutrali.test"
MAIL_FROM_NAME="${APP_NAME}"