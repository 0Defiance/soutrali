<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Front Flutter en production : la racine doit servir l'application
    # web (index.html) plutôt que la page d'accueil Laravel, et les liens
    # profonds reviennent au shell Flutter. `/api`, `/admin` (Filament) et
    # `/livewire` (les scripts Livewire que Filament charge depuis cette
    # origine : les avaler casserait le login admin, œil du mot de passe et
    # soumission du formulaire) restent traités par le front controller
    # Laravel ci-dessous. Seules les requêtes GET/HEAD sont candidates au
    # repli. Hors Apache (artisan serve, tests), ce fichier est sans effet.
    DirectoryIndex index.html index.php

    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{REQUEST_URI} !^/(api|admin|livewire)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# ---------------------------------------------------------------------------
# Performance du front Flutter
#
# `main.dart.js` pèse 3,8 Mo : sur une connexion lente, c’est lui qui décide du
# temps de premier affichage. On force donc la compression des fichiers texte
# (utile même si mod_deflate est déjà actif ailleurs : certains hébergements
# ne compriment que le HTML), et on laisse au navigateur un cache explicite —
# sans en-tête de cache, il revalidait tout à chaque visite, y compris l’écran
# d’amorçage.
#
# Les noms de fichiers ne portent pas d’empreinte de contenu : les scripts et
# les JSON restent en `no-cache` (revalidation par ETag, quelques centaines
# d’octets) pour qu’un déploiement soit toujours vu. Seules les images et les
# polices, stables, reçoivent un cache long.
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
    <IfModule mod_filter.c>
        AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
        AddOutputFilterByType DEFLATE text/javascript application/javascript application/json
        AddOutputFilterByType DEFLATE image/svg+xml application/wasm
        # Polices (TTF) : ~30 % de gagnés sur 187 Ko de texte, pas de perte.
        AddOutputFilterByType DEFLATE application/x-font-ttf font/ttf application/font-sfnt
    </IfModule>
</IfModule>

# Brotli est volontairement écarté pour les gros fichiers : mesuré sur cet
# hébergement le 8 novembre 2026, `main.dart.js` arrive en 26,9 s compressé en
# brotli contre 14,8 s en gzip — la compression coûte plus de temps qu’elle
# n’économise d’octets (999 Ko contre 1,09 Mo). Même chose pour le WebAssembly.
# Les navigateurs annoncent `br` : on le leur retire sur ces fichiers pour
# qu’ils reçoivent du gzip.
<IfModule mod_brotli.c>
    SetEnvIf Request_URI "\.(js|mjs|wasm)$" no-brotli
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(js|mjs|json|html|wasm)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(png|jpg|jpeg|webp|gif|svg|ico|ttf|otf|woff|woff2)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>
