<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Front Flutter en production : la racine doit servir l'application
    # web (index.html) plutôt que la page d'accueil Laravel, et les liens
    # profonds reviennent au shell Flutter. `/api`, `/admin` (Filament) et
    # `/livewire` (les scripts Livewire que Filament charge depuis cette
    # origine : les avaler casserait le login admin, œil du mot de passe et
    # soumission du formulaire) restent traités par le front controller
    # Laravel ci-dessous. Seules les requêtes GET/HEAD sont candidates au
    # repli. Hors Apache (artisan serve, tests), ce fichier est sans effet.
    DirectoryIndex index.html index.php

    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{REQUEST_URI} !^/(api|admin|livewire)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
